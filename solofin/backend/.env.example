NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Compte administrateur SoloFin
ADMIN_EMAIL=votre@email.com
ADMIN_PASSWORD=changez_ce_mot_de_passe

SESSION_SECRET=change_me_in_production_256bits
DB_PATH=./database/solofin.db
ENCRYPTION_KEY=change_me_in_production_256bits

# Google OAuth (Sprint 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Claude API — OCR et extraction uniquement (Sprint 3)
ANTHROPIC_API_KEY=

# Ollama — Agent IA "Ask SoloFin" (local, gratuit — ollama.com)
# OLLAMA_MODEL=llama3.2  # optionnel, llama3.2 par défaut

# SMTP — envoi des relances clients (Sprint 14 Bis)
# Utiliser un App Password Gmail : compte Google → Sécurité → Mots de passe des applications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
SMTP_FROM=votre@gmail.com
